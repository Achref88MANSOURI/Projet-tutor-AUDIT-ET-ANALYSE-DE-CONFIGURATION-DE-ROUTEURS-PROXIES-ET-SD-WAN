{{ source_line | DIGIT | to_int }} no authentication key-chain {{ key_chain }} {{ level }}
</group>

<group name="auth_isis_area_key*" method="table" functions="set(True, secret_configured)">
{{ source_line | DIGIT | to_int }} area-password __ROUTING_SECRET_PRESENT__
</group>

