</group>

<group name="auth_isis_send_level*" method="table" functions="set(True, configured)">
{{ source_line | DIGIT | to_int }} authentication send-only {{ level }}
</group>

<group name="auth_isis_mode_remove*" method="table" functions="set(True, removed)">
