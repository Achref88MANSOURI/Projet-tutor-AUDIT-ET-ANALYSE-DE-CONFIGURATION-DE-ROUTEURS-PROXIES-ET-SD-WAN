<group name="advanced_isis*" method="table">
{{ source_line | DIGIT | to_int }} router isis {{ process }}
</group>

<group name="advanced_isis_net*" method="table">
{{ source_line | DIGIT | to_int }} net {{ net }}
</group>

<group name="advanced_isis_passive*" method="table">
{{ source_line | DIGIT | to_int }} passive-interface {{ interface }}
</group>


<group name="auth_isis_mode*" method="table" functions="set(True, configured)">
{{ source_line | DIGIT | to_int }} authentication mode {{ mode }}
</group>

<group name="auth_isis_mode_level*" method="table" functions="set(True, configured)">
{{ source_line | DIGIT | to_int }} authentication mode {{ mode }} {{ level }}
</group>

<group name="auth_isis_chain*" method="table" functions="set(True, configured)">
